Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TubeProduct", "[", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0"}], "]"}], ",", 
      "\[CapitalPi]1"}], "]"}], "==", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"4", "\[Pi]", " ", 
       RowBox[{"I", "/", "5"}]}], "]"}], "\[CapitalPi]1"}]}], "/.", 
   RowBox[{"\[Phi]", "->", 
    FractionBox[
     RowBox[{
      SqrtBox["5"], "+", "1"}], "2"]}]}], "//", "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TubeProduct", "[", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0"}], "]"}], ",", 
      "\[CapitalPi]2"}], "]"}], "==", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "4"}], "\[Pi]", " ", 
       RowBox[{"I", "/", "5"}]}], "]"}], "\[CapitalPi]2"}]}], "/.", 
   RowBox[{"\[Phi]", "->", 
    FractionBox[
     RowBox[{
      SqrtBox["5"], "+", "1"}], "2"]}]}], "//", "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.975149386189488*^9, 3.975149470904557*^9}},
