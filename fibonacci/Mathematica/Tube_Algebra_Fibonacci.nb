       RowBox[{"R", "[", "h", "]"}], "[", 
       RowBox[{"c", ",", 
        RowBox[{"\[Mu]", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"FF", "[", 
         RowBox[{
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "c", ",", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "[", "d", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"g", "+", "1"}], ",", 
         RowBox[{"h", "+", "1"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
      RowBox[{"Conjugate", "[", 
       RowBox[{
        RowBox[{"R", "[", "g", "]"}], "[", 
        RowBox[{
         RowBox[{"\[Mu]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "c"}], "]"}], "]"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"FFinv", "[", 
         RowBox[{
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "c"}], "]"}], "[", "d", "]"}],
        "[", 
       RowBox[{"[", 
        RowBox[{
