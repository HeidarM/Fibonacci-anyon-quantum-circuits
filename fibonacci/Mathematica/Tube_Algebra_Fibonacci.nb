Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"TubeProduct", "[", 
       RowBox[{"T", ",", "\[CapitalPi]0"}], "]"}], "==", "\[CapitalPi]0"}], "//",
      "\[Phi]Simplify"}], ",", "       ", 
    RowBox[{"(*", " ", 
     RowBox[{"(", 
      RowBox[{"1", ",", "1"}], ")"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TubeProduct", "[", 
      RowBox[{"T", ",", "\[CapitalPi]1"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"4", "\[Pi]", " ", 
        RowBox[{"I", "/", "5"}]}], "]"}], "\[CapitalPi]1"}]}], ",", "      ", 
    
    RowBox[{"(*", " ", 
     RowBox[{"(", 
      RowBox[{"\[Tau]", ",", "0"}], ")"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TubeProduct", "[", 
      RowBox[{"T", ",", "\[CapitalPi]2"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], "\[Pi]", " ", 
        RowBox[{"I", "/", "5"}]}], "]"}], "\[CapitalPi]2"}]}], ",", "    ", 
    RowBox[{"(*", " ", 
     RowBox[{"(", 
      RowBox[{"0", ",", "\[Tau]"}], ")"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TubeProduct", "[", 
      RowBox[{"T", ",", "\[CapitalPi]3"}], "]"}], "==", "\[CapitalPi]3"}]}], 
   "}"}], "//", "\[Phi]Simplify", "        ", 
  RowBox[{"(*", " ", 
   RowBox[{"(", 
    RowBox[{"\[Tau]", ",", "\[Tau]"}], ")"}], " ", "*)"}]}]], "Input",
