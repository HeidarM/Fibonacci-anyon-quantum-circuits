Cell[CellGroupData[{

Cell["Minimal central idempotents of Tube(C) algebra", "Subsection",
 CellChangeTimes->{{3.9748080330895767`*^9, 
  3.974808053798311*^9}},ExpressionUUID->"ea609e78-9a0e-45f9-96a1-\
9465cf5554c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "To", " ", "make", " ", "mathematica", " ", "simplify", " ", "properly"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"to\[Phi]", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{"ReplaceAll", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
        RowBox[{"Sqrt", "[", "5", "]"}], "->", 
        RowBox[{
         RowBox[{"2", " ", "\[Phi]"}], "-", "1"}]}]}], "]"}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"toPhase", "[", "expr_", "]"}], ":=", 
    RowBox[{"expr", "/.", " ", 
     RowBox[{
      RowBox[{"Power", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "r_Rational"}], "]"}], ":>", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "Pi", " ", "r"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]Simplify", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{"expr", "/.", 
      RowBox[{"\[Phi]", "->", 
       FractionBox[
        RowBox[{
         RowBox[{"Sqrt", "[", "5", "]"}], "+", "1"}], "2"]}]}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tubeSimplify", "[", "expression_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"expression", "/.", 
         RowBox[{"\[Phi]", "->", 
          FractionBox[
           RowBox[{
            RowBox[{"Sqrt", "[", "5", "]"}], "+", "1"}], "2"]}]}], "//", 
        RowBox[{
         RowBox[{"Collect", "[", 
          RowBox[{"#", ",", "_B"}], "]"}], "&"}]}], "//", 
       RowBox[{
        RowBox[{"Plus", "@@", 
         RowBox[{"FullSimplify", "/@", 
          RowBox[{"List", "@@", "#"}]}]}], "&"}]}], "//", "to\[Phi]"}], "//", 
     "toPhase"}]}]}]}]], "Input",
 CellChangeTimes->{{3.974965095527688*^9, 3.974965107143167*^9}, {
  3.974965139792019*^9, 3.9749651399362926`*^9}, {3.974966414019595*^9, 
  3.974966421228986*^9}, {3.9749664598460617`*^9, 3.974966496968068*^9}, {
