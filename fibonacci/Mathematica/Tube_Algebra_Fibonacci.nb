Cell[CellGroupData[{

Cell["Definitions (Tube algebra product)", "Subsection",
 CellChangeTimes->{{3.974806762113275*^9, 
  3.9748067684642963`*^9}},ExpressionUUID->"14bcb38e-b8e9-4999-9c20-\
77a560a80b91"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"bProd", "[", 
      RowBox[{
       RowBox[{"B", "[", 
        RowBox[{"p_", ",", "s_", ",", "q_", ",", "u_"}], "]"}], ",", 
       RowBox[{"B", "[", 
        RowBox[{"pt_", ",", "st_", ",", "qt_", ",", "ut_"}], "]"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"pt", ",", "q"}], "]"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"d", "[", "s", "]"}], 
            RowBox[{"d", "[", "st", "]"}]}], 
           RowBox[{"d", "[", "\[Beta]", "]"}]], "]"}], 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{"ut", ",", "st", ",", "q"}], "]"}], "[", 
          RowBox[{"u", ",", "s", ",", "\[Alpha]"}], "]"}], 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{"st", ",", "qt", ",", "ut"}], "]"}], "[", 
          RowBox[{"\[Alpha]", ",", "s", ",", "\[Beta]"}], "]"}], 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{"\[Alpha]", ",", "st", ",", "u"}], "]"}], "[", 
          RowBox[{"s", ",", "p", ",", "\[Beta]"}], "]"}], 
         RowBox[{"B", "[", 
          RowBox[{"p", ",", "\[Beta]", ",", "qt", ",", "\[Alpha]"}], "]"}]}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Beta]", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Split", " ", "an", " ", "expression", " ", "into", " ", "additive", " ", 
     "terms"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"bTerms", "[", "expr_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"Expand", "[", "expr", "]"}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "e", "]"}], "===", "Plus"}], ",", 
         RowBox[{"List", "@@", "e"}], ",", 
         RowBox[{"{", "e", "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"For", " ", "a", " ", "single", " ", "term"}], ",", 
     RowBox[{"extract", " ", "coefficient", " ", "and", " ", "basis"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bCoeff", "[", "term_", "]"}], ":=", 
     RowBox[{"term", "/.", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c_.", " ", 
         RowBox[{"B", "[", "___", "]"}]}], ":>", "c"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bBasis", "[", "term_", "]"}], ":=", 
     RowBox[{"term", "/.", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c_.", " ", "b_B"}], ":>", "b"}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Multiply", " ", "two", " ", "superpositions", " ", "by", " ", 
     "bilinearity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TubeProduct", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tx", "=", 
          RowBox[{"bTerms", "[", "x", "]"}]}], ",", 
         RowBox[{"ty", "=", 
          RowBox[{"bTerms", "[", "y", "]"}]}]}], "}"}], ",", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"Total", "@", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"bCoeff", "[", 
               RowBox[{"tx", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", 
              RowBox[{"bCoeff", "[", 
               RowBox[{"ty", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}], "*", 
              RowBox[{"bProd", "[", 
               RowBox[{
                RowBox[{"bBasis", "[", 
                 RowBox[{"tx", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
                RowBox[{"bBasis", "[", 
                 RowBox[{"ty", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "tx", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "ty", "]"}]}], "}"}]}], "]"}]}]}], ",", 
         "_B"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TubeCommutator", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"TubeProduct", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "-", 
     RowBox[{"TubeProduct", "[", 
      RowBox[{"y", ",", "x"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.97480678264795*^9, 3.974806790151889*^9}, {
   3.974806823762905*^9, 3.974806852021783*^9}, {3.974806932132167*^9, 
   3.974806954697873*^9}, 3.9748071585661707`*^9, {3.975144091074263*^9, 
