          RowBox[{"SdoubleFib", "[", 
           RowBox[{"\[Mu]", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], "]"}], 
          RowBox[{"B", "[", 
           RowBox[{"a", ",", "c", ",", "a", ",", "dd"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
