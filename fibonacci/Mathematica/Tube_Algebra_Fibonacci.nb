 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Minimal", " ", "central", " ", "idempotents", " ", "for", " ", "a", " ", 
    "modular", " ", "category", " ", "C"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"2", "+", 
    RowBox[{
    "\[Phi]", " ", "added", " ", "extra", " ", "for", " ", "simpler", " ", 
     "normalization"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[CapitalPi]", "[", "\[Mu]_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
