Cell[TextData[{
 "For a fusion category, C, we have that Z(C) = Rep(Tube(C)).\n\nSimple \
objects of the Drinfeld center Z(C) consists of pairs (Z, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "Z"], ")"}], TraditionalForm]],ExpressionUUID->
  "a32acd31-9763-453b-9dd5-ee1761dbed6f"],
 " where Z is a (generally non-simple) element of C and \[Gamma] is the \
half-braiding isomorphisms. \[Gamma] has to satisfy a Hexagon equation for \
consistency.\n\nIf C is modular, there is an explicit way to express \[Gamma] \
in terms of the data of C (F and R matrices). The expression given in Hu et \
al, does not satisfy the \[OpenCurlyDoubleQuote]neutrality equation\
\[CloseCurlyDoubleQuote] they state.\n\nI have derived them myself from, \
following the notation of Choi et al, and they are satisfied. And give access \
to minimal central idempotents of Tube(C)."
}], "Text",
 CellChangeTimes->{{3.9748026365821667`*^9, 
  3.974802901628561*^9}},ExpressionUUID->"aa7c8e13-2c83-4fa1-a319-\
ab145274e0c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Hu", " ", "et", " ", "al", " ", 
    RowBox[{"convensions", ":", " ", 
     RowBox[{
     "Has", " ", "some", " ", "errors", " ", "it", " ", "appears"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"z", "[", 
      RowBox[{"{", 
       RowBox[{"i_", ",", "jj_"}], "}"}], "]"}], "[", 
     RowBox[{"p_", ",", "j_", ",", "q_", ",", "t_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"jj", ",", "j"}], "]"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"d", "\[IndentingNewLine]", "[", "a", "]"}], 
          RowBox[{"d", "[", "b", "]"}], 
          RowBox[{
           RowBox[{"R", "[", "a", "]"}], "[", 
           RowBox[{"i", ",", "k"}], "]"}], 
          RowBox[{
           RowBox[{"R", "[", "b", "]"}], "[", 
           RowBox[{"j", ",", "k"}], "]"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"a", ",", "i", ",", "k"}], "]"}], "[", 
           RowBox[{"b", ",", "j", ",", "t"}], "]"}], 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"i", ",", "j", ",", "q"}], "]"}], "[", 
           RowBox[{"t", ",", "k", ",", "a"}], "]"}], 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"i", ",", "b", ",", "t"}], "]"}], "[", 
           RowBox[{"k", ",", "p", ",", "j"}], "]"}]}], "\[IndentingNewLine]", 
         ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "//", 
      "Simplify"}], "//", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", "\[Phi]"}], "]"}], "&"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"They", " ", "call", " ", "it", " ", "neutrality"}], ",", " ", 
     RowBox[{"but", " ", "I", " ", "believe", " ", 
      RowBox[{"it", "'"}], "s", " ", "just", " ", "the", " ", "hexagon", " ", 
      
      RowBox[{"realtions", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"neutralityConditionCheck", "[", "z_", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "[", "r", "]"}], 
           RowBox[{"d", "[", "s", "]"}], 
           RowBox[{
            RowBox[{"z", "[", "J", "]"}], "[", 
            RowBox[{"l", ",", "n", ",", "q", ",", "r"}], "]"}], 
           RowBox[{
            RowBox[{"z", "[", "J", "]"}], "[", 
            RowBox[{"p", ",", "m", ",", "l", ",", "s"}], "]"}], 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"m", ",", "s", ",", "l"}], "]"}], "[", 
            RowBox[{"n", ",", "r", ",", "t"}], "]"}], 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"s", ",", "p", ",", "m"}], "]"}], "[", 
            RowBox[{"j", ",", "n", ",", "t"}], "]"}], 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"m", ",", "t", ",", "r"}], "]"}], "[", 
            RowBox[{"q", ",", "n", ",", "k"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}], " ", "==", " ", 
        
        RowBox[{
         RowBox[{"\[Delta]", "[", 
          RowBox[{"m", ",", "n", ",", "j"}], "]"}], 
         FractionBox[
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "k"}], "]"}], 
          RowBox[{"d", "[", "j", "]"}]], 
         RowBox[{
          RowBox[{"z", "[", "J", "]"}], "[", 
          RowBox[{"p", ",", "j", ",", "q", ",", "t"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"J", ",", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", "2"}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9742680059275618`*^9, 3.974268013478321*^9}, {
