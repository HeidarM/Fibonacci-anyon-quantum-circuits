     RowBox[{
      RowBox[{"idempotent", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           FractionBox[
            RowBox[{"d", "[", "dd", "]"}], 
            RowBox[{
             RowBox[{"d", "[", "a", "]"}], 
             RowBox[{"d", "[", "c", "]"}]}]], "]"}], 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalOmega]", "[", "dd", "]"}], "[", 
            RowBox[{"a", ",", "\[Nu]"}], "]"}], "[", 
