Cell[BoxData[{
 RowBox[{
  RowBox[{"fullBasis", "=", 
   RowBox[{"B", "@@@", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", "4"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"twistFull", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"TubeProduct", "[", 
       RowBox[{"T", ",", "#"}], "]"}], "&"}], "/@", "fullBasis"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonZeroPositions", "=", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Position", "[", 
      RowBox[{"twistFull", ",", 
       RowBox[{"Except", "[", "0", "]"}], ",", 
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"Heads", "->", "False"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tubeBasis", "=", 
   RowBox[{"fullBasis", "[", 
    RowBox[{"[", "nonZeroPositions", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tubeTwist", "=", 
   RowBox[{"twistFull", "[", 
    RowBox[{"[", "nonZeroPositions", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
