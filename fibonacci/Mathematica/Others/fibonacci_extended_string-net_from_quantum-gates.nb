Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "OneQGate", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OneQGate", "[", 
     RowBox[{"U_", ",", 
      RowBox[{"k_Integer", "?", "Positive"}]}], "]"}], "[", "psi_SparseArray",
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dim", "=", 
        RowBox[{"Length", "[", "psi", "]"}]}], ",", "n", ",", "idL", ",", 
       "idR", ",", "op"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "dim"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idL", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i_", ",", "i_"}], "}"}], "->", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}]}], ",", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idR", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i_", ",", "i_"}], "}"}], "->", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "-", "k"}], ")"}]}], ",", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "-", "k"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"op", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"idL", ",", "U", ",", "idR"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"op", ".", "psi"}]}]}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.972383771008505*^9, 3.972383780906061*^9}, {
