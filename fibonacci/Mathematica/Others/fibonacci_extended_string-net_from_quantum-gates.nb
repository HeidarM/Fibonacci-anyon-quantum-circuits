Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "MultiControlGate", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MultiControlGate", "[", 
     RowBox[{
      RowBox[{"U_", "?", "MatrixQ"}], ",", 
      RowBox[{"controls", ":", 
       RowBox[{"{", "__Integer", "}"}]}], ",", 
      RowBox[{"target_Integer", "?", "Positive"}]}], "]"}], "[", 
    "psi_SparseArray", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dim", "=", 
        RowBox[{"Length", "[", "psi", "]"}]}], ",", "n", ",", "I2", ",", "P1",
        ",", "D", ",", "opCond", ",", "opTotal", ",", "mats"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"infer", " ", "number", " ", "of", " ", "qubits"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "dim"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2", "x2", " ", "building", " ", "blocks"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"I2", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", "2"}], "}"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"identity", " ", "on", " ", "one", " ", "qubit"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"P1", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"projector", "|", 
        RowBox[{"1", ">", "<", "1"}], "|", 
        RowBox[{"on", " ", "one", " ", "qubit"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"D", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"U", "-", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"U", "-", 
        RowBox[{"I", " ", "on", " ", "target", " ", "qubit"}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "tensor", " ", "factor", " ", "for", " ", "each", " ", "qubit", " ", 
         "j"}], "=", 
        RowBox[{
         RowBox[{"1", ".."}], "n"}]}], "*)"}], 
      RowBox[{"mats", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"j", "===", "target"}], ",", "\[IndentingNewLine]", "D", ",", 
           RowBox[{"(*", 
            RowBox[{"target", ":", 
             RowBox[{"U", "-", "I"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"controls", ",", "j"}], "]"}], ",", "P1", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"controls", ":", " ", 
             RowBox[{"|", 
              RowBox[{"1", ">", "<", "1"}], "|"}]}], "*)"}], 
           "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", "I2"}], 
          " ", 
          RowBox[{"(*", 
           RowBox[{"others", ":", "identity"}], "*)"}], "\[IndentingNewLine]",
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"conditional", " ", 
         RowBox[{"part", ":", 
          RowBox[{
          "only", " ", "acts", " ", "when", " ", "all", " ", "controls"}]}]}],
         "=", "1"}], "*)"}], 
      RowBox[{"opCond", "=", 
       RowBox[{"KroneckerProduct", "@@", "mats"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"full", " ", 
        RowBox[{"operator", ":", 
         RowBox[{"I", "+", 
          RowBox[{"(", " ", 
           RowBox[{"|", 
            RowBox[{
             RowBox[{
              RowBox[{"1", "..."}], "1"}], ">", 
             RowBox[{"_controls", " ", 
              RowBox[{"(", 
               RowBox[{"U", "-", "I"}], ")"}], "_target"}]}]}], ")"}]}]}]}], 
       "*)"}], 
      RowBox[{"opTotal", "=", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{
