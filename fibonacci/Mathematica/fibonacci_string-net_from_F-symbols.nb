Cell[BoxData[
 RowBox[{
  RowBox[{"TubeProduct", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "s_", ",", "q_", ",", "u_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pt_", ",", "st_", ",", "qt_", ",", "ut_"}], "}"}], ",", 
    RowBox[{"print_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "result", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"result", " ", "=", " ", 
      RowBox[{
       RowBox[{"prod", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "s", ",", "q", ",", "u"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"pt", ",", "st", ",", "qt", ",", "ut"}], "}"}]}], "]"}], "//",
        "TubeRepresentation"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"print", ",", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"B", "[", 
            RowBox[{"p", ",", "s", ",", "q", ",", "u"}], "]"}], "\[Cross]", 
           RowBox[{"B", "[", 
            RowBox[{"pt", ",", "st", ",", "qt", ",", "ut"}], "]"}]}], "==", 
          "result"}], "//", "TubeRepresentation"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "result"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
