Cell[BoxData[
 RowBox[{
  RowBox[{"PlotTubeState3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "s_", ",", "q_", ",", "u_"}], "}"}], ",", 
    RowBox[{"imageSize_", ":", "40"}]}], " ", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "L1", ",", "L2", ",", "L3", ",", "C1", ",", "cylinder", ",", "radius"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"radius", " ", "=", " ", "0.3"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"L1", "=", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}], ",", 
        RowBox[{"Thickness", "[", "lineThickness", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "radius"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "radius"}], ",", 
             RowBox[{"1", "/", "3"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"L2", "=", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}], ",", 
        RowBox[{"Thickness", "[", "lineThickness", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "radius"}], ",", 
             RowBox[{"1", "/", "3"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "radius"}], ",", 
             RowBox[{"2", "/", "3"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"L3", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}], ",", 
        RowBox[{"Thickness", "[", "lineThickness", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "radius"}], ",", 
             RowBox[{"2", "/", "3"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "radius"}], ",", 
             RowBox[{"3", "/", "3"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"C1", " ", "=", " ", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"radius", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"t", "+", 
             FractionBox[
              RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}], ",", 
          RowBox[{"radius", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"t", "+", 
             FractionBox[
              RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"1", "/", "3"}], " ", "+", " ", 
           RowBox[{
            FractionBox["t", 
             RowBox[{"2", "\[Pi]"}]], 
            FractionBox["1", "3"]}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", 
          RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Red", ",", 
           RowBox[{"Thickness", "[", "lineThickness", "]"}], ",", 
           RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}]}], "}"}]}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"cylinder", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Opacity", "[", ".4", "]"}], ",", 
        RowBox[{"EdgeForm", "[", 
         RowBox[{"Opacity", "[", ".4", "]"}], "]"}], ",", 
        RowBox[{"Cylinder", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
          "radius"}], "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cylinder", ",", 
         RowBox[{"spin", "[", 
          RowBox[{"p", ",", "L1"}], "]"}], ",", 
         RowBox[{"spin", "[", 
          RowBox[{"s", ",", 
           RowBox[{"First", "@", 
            RowBox[{"Normal", "@", "C1"}]}]}], "]"}], ",", 
         RowBox[{"spin", "[", 
          RowBox[{"u", ",", "L2"}], "]"}], ",", 
         RowBox[{"spin", "[", 
          RowBox[{"q", ",", "L3"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"Boxed", "->", "False"}], ",", 
       RowBox[{"ImageSize", "->", "imageSize"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
