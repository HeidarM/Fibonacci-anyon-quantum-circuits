Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Condition", " ", "for", " ", "projectors", " ", "in", " ", 
     SubscriptBox["A", "q"]}], "\[Subset]", "A"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eqs", "=", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalPi]", "[", 
          RowBox[{"q", ",", "\[Beta]", ",", "\[Alpha]"}], "]"}], "==", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalPi]", "[", 
             RowBox[{"q", ",", "s", ",", "u"}], "]"}], 
            RowBox[{"\[CapitalPi]", "[", 
             RowBox[{"q", ",", "st", ",", "ut"}], "]"}], " ", 
            RowBox[{"Sqrt", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"d", "[", "s", "]"}], 
               RowBox[{"d", "[", "st", "]"}]}], 
              RowBox[{"d", "[", "\[Beta]", "]"}]], "]"}], 
            RowBox[{
             RowBox[{"F", "[", 
              RowBox[{"ut", ",", "st", ",", " ", "q"}], "]"}], "[", 
             RowBox[{"u", ",", "s", ",", "\[Alpha]"}], "]"}], 
            RowBox[{
             RowBox[{"F", "[", 
              RowBox[{"st", ",", "q", ",", "ut"}], "]"}], "[", 
             RowBox[{"\[Alpha]", ",", "s", ",", "\[Beta]"}], "]"}], 
            RowBox[{
             RowBox[{"F", "[", 
              RowBox[{"\[Alpha]", ",", "st", ",", "u"}], "]"}], "[", 
             RowBox[{"s", ",", "q", ",", "\[Beta]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"st", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ut", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"q", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Beta]", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "0", ",", "1"}], "}"}]}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", " ", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalPi]", "[", 
         RowBox[{"q", ",", "\[Beta]", ",", "\[Alpha]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Beta]", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "0", ",", "1"}], "}"}]}], "]"}], "//", 
      "Flatten"}]}], ";"}]}]}]], "Input",
