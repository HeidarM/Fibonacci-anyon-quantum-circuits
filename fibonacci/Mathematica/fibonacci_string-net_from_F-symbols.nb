   "To", " ", "make", " ", "mathematica", " ", "simplify", " ", "properly"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"to\[Phi]", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{"ReplaceAll", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
