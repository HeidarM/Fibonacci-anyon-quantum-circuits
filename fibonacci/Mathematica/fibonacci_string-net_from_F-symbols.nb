Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "halfBraidingHexagonConditionCheck", "[", "\[CapitalOmega]_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Sum", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "e", "]"}], "[", 
           RowBox[{"a", ",", "\[Mu]"}], "]"}], "[", 
          RowBox[{"d", ",", "f"}], "]"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"FFinv", "[", 
            RowBox[{"a", ",", "f", ",", "b"}], "]"}], "[", "c", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"e", "+", "1"}], ",", 
            RowBox[{"g", "+", "1"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "g", "]"}], "[", 
           RowBox[{"b", ",", "\[Mu]"}], "]"}], "[", 
          RowBox[{"f", ",", "h"}], "]"}]}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"f", ",", "0", ",", "1"}], "}"}]}], "]"}], 
      "\[IndentingNewLine]", "==", "\[IndentingNewLine]", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"FFinv", "[", 
            RowBox[{"d", ",", "a", ",", "b"}], "]"}], "[", "c", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"e", "+", "1"}], ",", 
            RowBox[{"ap", "+", "1"}]}], "]"}], "]"}], 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "c", "]"}], "[", 
           RowBox[{"ap", ",", "\[Mu]"}], "]"}], "[", 
          RowBox[{"d", ",", "h"}], "]"}], 
         RowBox[{
          RowBox[{
           RowBox[{"FFinv", "[", 
            RowBox[{"a", ",", "b", ",", "h"}], "]"}], "[", "c", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"ap", "+", "1"}], ",", 
            RowBox[{"g", "+", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
        ",", 
        RowBox[{"{", 
         RowBox[{"ap", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", "2"}], "]"}]}], "}"}]}], 
    "]"}]}], "\[IndentingNewLine]"}]], "Input",
