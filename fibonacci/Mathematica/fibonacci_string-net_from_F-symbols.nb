Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"bProd", "[", 
      RowBox[{
       RowBox[{"B", "[", 
        RowBox[{"p_", ",", "s_", ",", "q_", ",", "u_"}], "]"}], ",", 
       RowBox[{"B", "[", 
        RowBox[{"pt_", ",", "st_", ",", "qt_", ",", "ut_"}], "]"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"pt", ",", "q"}], "]"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"d", "[", "s", "]"}], 
            RowBox[{"d", "[", "st", "]"}]}], 
           RowBox[{"d", "[", "\[Beta]", "]"}]], "]"}], 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{"ut", ",", "st", ",", "q"}], "]"}], "[", 
          RowBox[{"u", ",", "s", ",", "\[Alpha]"}], "]"}], 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{"st", ",", "qt", ",", "ut"}], "]"}], "[", 
          RowBox[{"\[Alpha]", ",", "s", ",", "\[Beta]"}], "]"}], 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{"\[Alpha]", ",", "st", ",", "u"}], "]"}], "[", 
          RowBox[{"s", ",", "p", ",", "\[Beta]"}], "]"}], 
         RowBox[{"B", "[", 
          RowBox[{"p", ",", "\[Beta]", ",", "qt", ",", "\[Alpha]"}], "]"}]}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Beta]", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Split", " ", "an", " ", "expression", " ", "into", " ", "additive", " ", 
     "terms"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"bTerms", "[", "expr_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"Expand", "[", "expr", "]"}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "e", "]"}], "===", "Plus"}], ",", 
         RowBox[{"List", "@@", "e"}], ",", 
         RowBox[{"{", "e", "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"For", " ", "a", " ", "single", " ", "term"}], ",", 
     RowBox[{"extract", " ", "coefficient", " ", "and", " ", "basis"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bCoeff", "[", "term_", "]"}], ":=", 
     RowBox[{"term", "/.", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c_.", " ", 
         RowBox[{"B", "[", "___", "]"}]}], ":>", "c"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bBasis", "[", "term_", "]"}], ":=", 
     RowBox[{"term", "/.", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c_.", " ", "b_B"}], ":>", "b"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Multiply", " ", "two", " ", "superpositions", " ", "by", " ", 
     "bilinearity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MultiplyB", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tx", "=", 
          RowBox[{"bTerms", "[", "x", "]"}]}], ",", 
         RowBox[{"ty", "=", 
          RowBox[{"bTerms", "[", "y", "]"}]}]}], "}"}], ",", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"Total", "@", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"bCoeff", "[", 
               RowBox[{"tx", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", 
              RowBox[{"bCoeff", "[", 
               RowBox[{"ty", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}], "*", 
              RowBox[{"bProd", "[", 
               RowBox[{
                RowBox[{"bBasis", "[", 
                 RowBox[{"tx", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
                RowBox[{"bBasis", "[", 
                 RowBox[{"ty", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "tx", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "ty", "]"}]}], "}"}]}], "]"}]}]}], ",", 
         "_B"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",\

