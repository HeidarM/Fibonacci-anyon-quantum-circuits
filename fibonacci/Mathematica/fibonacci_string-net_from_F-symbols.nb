Cell[BoxData[
 RowBox[{
  RowBox[{"prod", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "s_", ",", "q_", ",", "u_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pt_", ",", "st_", ",", "qt_", ",", "ut_"}], "}"}]}], "]"}], ":=",
   " ", 
  RowBox[{
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"pt", ",", "q"}], "]"}], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"d", "[", "s", "]"}], 
         RowBox[{"d", "[", "st", "]"}]}], 
        RowBox[{"d", "[", "\[Beta]", "]"}]], "]"}], 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"ut", ",", "st", ",", "q"}], "]"}], "[", 
       RowBox[{"u", ",", "s", ",", "\[Alpha]"}], "]"}], 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"st", ",", "qt", ",", "ut"}], "]"}], "[", 
       RowBox[{"\[Alpha]", ",", "s", ",", "\[Beta]"}], "]"}], 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"\[Alpha]", ",", "st", ",", "u"}], "]"}], "[", 
       RowBox[{"s", ",", "p", ",", "\[Beta]"}], "]"}], 
      RowBox[{"B", "[", 
       RowBox[{"p", ",", "\[Beta]", ",", "qt", ",", "\[Alpha]"}], "]"}]}], ",", 
     RowBox[{"{", 
