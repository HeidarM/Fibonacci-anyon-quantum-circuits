Cell[CellGroupData[{

Cell["Tube Algebra (OLD VERSION)", "Section",
 CellChangeTimes->{{3.974793474817463*^9, 3.9747934779814987`*^9}, {
  3.994245550210022*^9, 
  3.994245552615877*^9}},ExpressionUUID->"cea5e371-edeb-4774-b579-\
829bcbe62d02"],

Cell[CellGroupData[{

Cell["Definitions (Half-Braiding) of fusion category", "Subsection",
 CellChangeTimes->{{3.9747974173708267`*^9, 3.97479742209623*^9}, {
  3.974806739056827*^9, 3.974806744262539*^9}, {3.974962324562212*^9, 
  3.9749623291468267`*^9}},ExpressionUUID->"2370e38f-e97b-42ff-b68d-\
e894fa195321"],

Cell[TextData[{
 "For a fusion category, C, we have that Z(C) = Rep(Tube(C)).\n\nSimple \
objects of the Drinfeld center Z(C) consists of pairs (Z, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "Z"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8259012-1d88-47e5-8a9b-5adf1b1cab24"],
 " where Z is a (generally non-simple) element of C and \[Gamma] is the \
half-braiding isomorphisms. \[Gamma] has to satisfy a Hexagon equation for \
consistency.\n\nIf C is modular, there is an explicit way to express \[Gamma] \
in terms of the data of C (F and R matrices). The expression given in Hu et \
al, does not satisfy the \[OpenCurlyDoubleQuote]neutrality equation\
\[CloseCurlyDoubleQuote] they state.\n\nI have derived them myself from, \
following the notation of Choi et al, and they are satisfied. And give access \
to minimal central idempotents of Tube(C)."
}], "Text",
 CellChangeTimes->{{3.9748026365821667`*^9, 
  3.974802901628561*^9}},ExpressionUUID->"52ba3186-bc55-4a42-ae1d-\
6d5858c7f17e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Hu", " ", "et", " ", "al", " ", 
    RowBox[{"convensions", ":", " ", 
     RowBox[{
     "Has", " ", "some", " ", "errors", " ", "it", " ", "appears"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"z", "[", 
      RowBox[{"{", 
       RowBox[{"i_", ",", "jj_"}], "}"}], "]"}], "[", 
     RowBox[{"p_", ",", "j_", ",", "q_", ",", "t_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"jj", ",", "j"}], "]"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"d", "\[IndentingNewLine]", "[", "a", "]"}], 
          RowBox[{"d", "[", "b", "]"}], 
          RowBox[{
           RowBox[{"R", "[", "a", "]"}], "[", 
           RowBox[{"i", ",", "k"}], "]"}], 
          RowBox[{
           RowBox[{"R", "[", "b", "]"}], "[", 
           RowBox[{"j", ",", "k"}], "]"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"a", ",", "i", ",", "k"}], "]"}], "[", 
           RowBox[{"b", ",", "j", ",", "t"}], "]"}], 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"i", ",", "j", ",", "q"}], "]"}], "[", 
           RowBox[{"t", ",", "k", ",", "a"}], "]"}], 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"i", ",", "b", ",", "t"}], "]"}], "[", 
           RowBox[{"k", ",", "p", ",", "j"}], "]"}]}], "\[IndentingNewLine]", 
         ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "//", 
      "Simplify"}], "//", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", "\[Phi]"}], "]"}], "&"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"They", " ", "call", " ", "it", " ", "neutrality"}], ",", " ", 
     RowBox[{"but", " ", "I", " ", "believe", " ", 
      RowBox[{"it", "'"}], "s", " ", "just", " ", "the", " ", "hexagon", " ", 
      
      RowBox[{"realtions", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"neutralityConditionCheck", "[", "z_", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "[", "r", "]"}], 
           RowBox[{"d", "[", "s", "]"}], 
           RowBox[{
            RowBox[{"z", "[", "J", "]"}], "[", 
            RowBox[{"l", ",", "n", ",", "q", ",", "r"}], "]"}], 
           RowBox[{
            RowBox[{"z", "[", "J", "]"}], "[", 
            RowBox[{"p", ",", "m", ",", "l", ",", "s"}], "]"}], 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"m", ",", "s", ",", "l"}], "]"}], "[", 
            RowBox[{"n", ",", "r", ",", "t"}], "]"}], 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"s", ",", "p", ",", "m"}], "]"}], "[", 
            RowBox[{"j", ",", "n", ",", "t"}], "]"}], 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"m", ",", "t", ",", "r"}], "]"}], "[", 
            RowBox[{"q", ",", "n", ",", "k"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}], " ", "==", " ", 
        
        RowBox[{
         RowBox[{"\[Delta]", "[", 
          RowBox[{"m", ",", "n", ",", "j"}], "]"}], 
         FractionBox[
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "k"}], "]"}], 
          RowBox[{"d", "[", "j", "]"}]], 
         RowBox[{
          RowBox[{"z", "[", "J", "]"}], "[", 
          RowBox[{"p", ",", "j", ",", "q", ",", "t"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"J", ",", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", "2"}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9742680059275618`*^9, 3.974268013478321*^9}, {
  3.9742685203714323`*^9, 3.974268619491947*^9}, {3.974268679389729*^9, 
  3.97426868119672*^9}, {3.974269672335053*^9, 3.9742696890986567`*^9}, {
  3.974269803314208*^9, 3.974269812497384*^9}, {3.974269932263266*^9, 
  3.974269954097419*^9}, {3.974797428395458*^9, 3.974797447109901*^9}, {
  3.974797502562855*^9, 3.974797517630719*^9}, {3.97480188114828*^9, 
  3.97480192217164*^9}, {3.97480234397223*^9, 3.974802346665719*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"a28e8fa2-54ca-4960-978d-7b24fd342dff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Choi", " ", "et", " ", "al"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalOmega]", "[", "d_", "]"}], "[", 
     RowBox[{"c_", ",", "\[Mu]_"}], "]"}], "[", 
    RowBox[{"e_", ",", "f_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FFinv", "[", 
         RowBox[{"c", ",", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "[", "d", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"h", "+", "1"}], ",", 
         RowBox[{"f", "+", "1"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"R", "[", "h", "]"}], "[", 
       RowBox[{"c", ",", 
        RowBox[{"\[Mu]", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"FF", "[", 
         RowBox[{
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "c", ",", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "[", "d", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"g", "+", "1"}], ",", 
         RowBox[{"h", "+", "1"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
      RowBox[{"Conjugate", "[", 
       RowBox[{
        RowBox[{"R", "[", "g", "]"}], "[", 
        RowBox[{
         RowBox[{"\[Mu]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "c"}], "]"}], "]"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"FFinv", "[", 
         RowBox[{
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "c"}], "]"}], "[", "d", "]"}],
        "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"e", "+", "1"}], ",", 
         RowBox[{"g", "+", "1"}]}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"g", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "0", ",", "1"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.974268941882621*^9, 3.974268943437005*^9}, {
