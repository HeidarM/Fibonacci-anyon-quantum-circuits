Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "OneQGate", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OneQGate", "[", 
     RowBox[{"U_", ",", 
      RowBox[{"k_Integer", "?", "Positive"}]}], "]"}], "[", "psi_SparseArray",
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dim", "=", 
        RowBox[{"Length", "[", "psi", "]"}]}], ",", "n", ",", "idL", ",", 
       "idR", ",", "op"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "dim"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idL", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i_", ",", "i_"}], "}"}], "->", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}]}], ",", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idR", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i_", ",", "i_"}], "}"}], "->", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "-", "k"}], ")"}]}], ",", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "-", "k"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"op", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"idL", ",", "U", ",", "idR"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"op", ".", "psi"}]}]}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.972383771008505*^9, 3.972383780906061*^9}, {
  3.972386204156164*^9, 3.972386279540556*^9}, {3.972386579959365*^9, 
  3.972386580114276*^9}, {3.972387214436864*^9, 3.9723872422919703`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"4acb6d92-ba1a-4e0e-b81d-9098f57fd001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "MultiControlGate", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MultiControlGate", "[", 
     RowBox[{
      RowBox[{"U_", "?", "MatrixQ"}], ",", 
      RowBox[{"controls", ":", 
       RowBox[{"{", "__Integer", "}"}]}], ",", 
      RowBox[{"target_Integer", "?", "Positive"}]}], "]"}], "[", 
    "psi_SparseArray", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dim", "=", 
        RowBox[{"Length", "[", "psi", "]"}]}], ",", "n", ",", "I2", ",", "P1",
        ",", "D", ",", "opCond", ",", "opTotal", ",", "mats"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"infer", " ", "number", " ", "of", " ", "qubits"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "dim"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2", "x2", " ", "building", " ", "blocks"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"I2", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", "2"}], "}"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"identity", " ", "on", " ", "one", " ", "qubit"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"P1", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"projector", "|", 
        RowBox[{"1", ">", "<", "1"}], "|", 
        RowBox[{"on", " ", "one", " ", "qubit"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"D", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"U", "-", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"U", "-", 
        RowBox[{"I", " ", "on", " ", "target", " ", "qubit"}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "tensor", " ", "factor", " ", "for", " ", "each", " ", "qubit", " ", 
         "j"}], "=", 
        RowBox[{
         RowBox[{"1", ".."}], "n"}]}], "*)"}], 
      RowBox[{"mats", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"j", "===", "target"}], ",", "\[IndentingNewLine]", "D", ",", 
           RowBox[{"(*", 
            RowBox[{"target", ":", 
             RowBox[{"U", "-", "I"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"controls", ",", "j"}], "]"}], ",", "P1", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"controls", ":", " ", 
             RowBox[{"|", 
              RowBox[{"1", ">", "<", "1"}], "|"}]}], "*)"}], 
           "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", "I2"}], 
          " ", 
          RowBox[{"(*", 
           RowBox[{"others", ":", "identity"}], "*)"}], "\[IndentingNewLine]",
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"conditional", " ", 
         RowBox[{"part", ":", 
