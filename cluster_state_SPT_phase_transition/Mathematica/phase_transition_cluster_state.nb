         RowBox[{"valsR", ",", 
          RowBox[{"g", ">", "0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"iRneg", "=", 
        RowBox[{"indexAtOne", "[", 
         RowBox[{"valsR", ",", 
          RowBox[{"g", "<", "0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"iLpos", "=", 
        RowBox[{"indexAtOne", "[", 
         RowBox[{"valsL", ",", 
          RowBox[{"g", ">", "0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"iLneg", "=", 
        RowBox[{"indexAtOne", "[", 
         RowBox[{"valsL", ",", 
