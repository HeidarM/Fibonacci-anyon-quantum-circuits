       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", " ", "such", " ", "that"}], " ", "<", "L"}], "|", 
         RowBox[{"R", ">=", " ", "1"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Lpos", ",", "Rpos"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"Lpos", ",", 
