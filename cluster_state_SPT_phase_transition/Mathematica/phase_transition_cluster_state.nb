Cell[CellGroupData[{

Cell["String operator from Transfer Matrices", "Section",
 CellChangeTimes->{{3.9696161550076933`*^9, 3.9696161661149178`*^9}, {
  3.969817642342621*^9, 
  3.969817645344638*^9}},ExpressionUUID->"b7bf8c12-5979-46bd-9b5f-\
18ca8873df27"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Find", " ", "left", " ", "canonical", " ", 
  RowBox[{"form", ":", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Form", " ", "transfer", " ", "map"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"\t", 
  RowBox[{"\[CapitalEpsilon]", " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Sum]", "\[Sigma]"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["A", "\[Sigma]"], "\[Dagger]"], 
     SubscriptBox["A", "\[Sigma]"]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"\t", 
  RowBox[{"and", " ", "find", " ", "dominant", " ", "left", " ", 
   RowBox[{"eigenvector", "/", "eigenmatrix"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sum]", "\[Sigma]"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["A", "\[Sigma]"], "\[Dagger]"], " ", "l", " ", 
     SubscriptBox["A", "\[Sigma]"]}]}], " ", "=", " ", 
   RowBox[{"\[Eta]", " ", "l"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"with", " ", "\[Eta]"}], "=", "1."}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Then", " ", "decompose", " ", "l"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["R", "\[Dagger]"], 
     RowBox[{"R", ":", "\n", 
      RowBox[{"first", " ", "diagonalize", " ", "l"}]}]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["U", "\[Dagger]"], "DU", " ", "where", " ", "D", " ", 
     "is", " ", "a", " ", "positive", " ", "matrix"}]}]}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"due", " ", "to", " ", "construction", " ", "of", " ", 
    RowBox[{"T", ".", " ", "Then"}], " ", "we", " ", "have", " ", "R"}], "=", 
   
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Sqrt]", "D"}], " ", 
      RowBox[{"U", ".", "\n", "I"}], " ", "believe", " ", "Cholesky", " ", 
      "gives", " ", "the", " ", 
      RowBox[{"same", ".", "\n", "\n", "We"}], " ", "then", " ", "define", " ",
       "left"}], "-", 
     RowBox[{"canonical", " ", 
      RowBox[{"form", ":", "\n", 
       SubscriptBox["A", 
        RowBox[{"L", ",", "\[Sigma]"}]]}]}]}], ":=", 
    RowBox[{"R", " ", "A", " ", 
     SuperscriptBox["R", "\[Dagger]"]}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"From", " ", "this", " ", "one", " ", "can", " ", 
  RowBox[{"show", ":", " ", "that"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sum]", "\[Sigma]"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["A", 
       RowBox[{"L", ",", "\[Sigma]"}]], "\[Dagger]"], 
     SubscriptBox["A", 
      RowBox[{"L", ",", "\[Sigma]"}]]}]}], " ", "=", " ", "I"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"for", " ", "right"}], ",", " ", 
  RowBox[{"do", " ", "the", " ", "same", " ", "with"}]}], "\n", 
 RowBox[{"T", " ", "=", " ", 
  RowBox[{
   SuperscriptBox["\[CapitalEpsilon]", "\[Dagger]"], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Sum]", "\[Sigma]"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["A", "\[Sigma]"], "\[Dagger]"], 
     SubscriptBox["A", 
      "\[Sigma]"]}]}]}]}], "\n"}], \
"Code",ExpressionUUID->"8d79ed49-da6e-4603-a3e8-6bd40ee8dc3a"]], "Text",
 CellChangeTimes->{{3.9700412142785597`*^9, 3.970041551345931*^9}, {
  3.970041587559606*^9, 3.970041761105901*^9}, {3.970041793393661*^9, 
  3.9700418518345757`*^9}, {3.970042431027918*^9, 3.970042468897518*^9}, {
  3.970476866418726*^9, 
  3.970476866418944*^9}},ExpressionUUID->"045d5dac-1876-49a2-92ed-\
1a4b62ce69c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"toMat", "[", "A_", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"A", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9696162585203457`*^9, 3.969616258522468*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"b1f70f05-414a-441a-b5f5-07938baf1457"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Transfer", " ", "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"T", " ", 
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "=", "0"}], ")"}]}], ",", " ", 
    RowBox[{"EX", " ", 
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "=", "1"}], ")"}]}], ",", " ", 
    RowBox[{"EY", " ", 
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "=", "2"}], ")"}]}], ",", " ", 
    RowBox[{"EZ", " ", 
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "=", "3"}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ET", "[", "\[Alpha]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"toMat", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "\[Alpha]", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", 
               RowBox[{"j", "+", "1"}]}], "]"}], "]"}], 
            RowBox[{
             RowBox[{"M", "[", "i", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"\[Beta]1", ",", "\[Alpha]1"}], "]"}], "]"}], 
            RowBox[{"Conjugate", "@", 
             RowBox[{
              RowBox[{"M", "[", "j", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"\[Beta]2", ",", "\[Alpha]2"}], "]"}], "]"}]}]}], ",", 
           
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]1", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]2", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Beta]1", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Beta]2", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
