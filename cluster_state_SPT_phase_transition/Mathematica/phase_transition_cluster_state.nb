      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"L", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", "0", ",", "0", ",", 
            RowBox[{"1", "/", "2"}]}], "}"}]}], ",", "eigs", ",", "vecs", ",",
          "pos", ",", "R"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"eigs", ",", "vecs"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", "T", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "eigs", "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"dominant", " ", "eigenvalue", " ", "index"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"R", "=", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"R", "=", 
         RowBox[{"R", "/", 
          RowBox[{"(", 
           RowBox[{"L", ".", "R"}], ")"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"normalize", " ", "so", " ", 
           RowBox[{"(", 
            RowBox[{"L", "|", "R"}], ")"}]}], "=", "1"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"L", ",", "R"}], "}"}]}]}], "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"indexAtOne", "[", 
      RowBox[{"vals_", ",", "asm_"}], "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"First", "@", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"vals", ",", 
           RowBox[{"Assumptions", "->", "asm"}]}], "]"}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"#", "==", "1"}], "]"}], "&"}], ")"}]}], ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "This", " ", "version", " ", "makes", " ", "sure", " ", "right", " ", 
      "index", " ", "is", " ", "chosen", " ", "for", " ", "g"}], ">", 
     RowBox[{"0", " ", "and", " ", "g"}], "<", 
     RowBox[{
     "0", " ", "unlike", " ", "simpler", " ", "version", " ", "above"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
