       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Find", " ", "dominating", " ", "eigenvector"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"iRpos", "=", 
